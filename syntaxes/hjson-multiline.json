{
    "scopeName": "hjson-multiline.injection",
    "fileTypes": [
        "hjson"
    ],
    "injectionSelector": [
        "L:source.hjson -comment"
    ],
    "patterns": [
        {
            "comment": "HJSON '''...''' multiline, -- sql marker",
            "begin": "(''')(--\\s*sql)",
            "beginCaptures": {
                "2": {
                    "name": "comment.sql"
                }
            },
            "end": "(''')",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON '''...''' multiline, SQL keyword",
            "begin": "(?i)(''')(SELECT |INSERT INTO |DELETE |UPDATE |CREATE TABLE |CREATE INDEX)",
            "beginCaptures": {
                "2": {
                    "name": "keyword.sql"
                }
            },
            "end": "(''')",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON \"\"\"...\"\"\" multiline, -- sql marker",
            "begin": "(\"\"\")(--\\s*sql)",
            "beginCaptures": {
                "2": {
                    "name": "comment.sql"
                }
            },
            "end": "(\"\"\")",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON \"\"\"...\"\"\" multiline, SQL keyword",
            "begin": "(?i)(\"\"\")(SELECT |INSERT INTO |DELETE |UPDATE |CREATE TABLE |CREATE INDEX)",
            "beginCaptures": {
                "2": {
                    "name": "keyword.sql"
                }
            },
            "end": "(\"\"\")",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON \"...\" single-line, -- sql marker",
            "begin": "(\")(--\\s*sql)",
            "beginCaptures": {
                "2": {
                    "name": "comment.sql"
                }
            },
            "end": "(\")",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON \"...\" single-line, SQL keyword",
            "begin": "(?i)(\")(SELECT |INSERT INTO |DELETE |UPDATE |CREATE TABLE |CREATE INDEX)",
            "beginCaptures": {
                "2": {
                    "name": "keyword.sql"
                }
            },
            "end": "(\")",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON '...' single-line, -- sql marker",
            "begin": "(')(--\\s*sql)",
            "beginCaptures": {
                "2": {
                    "name": "comment.sql"
                }
            },
            "end": "(')",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON '...' single-line, SQL keyword",
            "begin": "(?i)(')(SELECT |INSERT INTO |DELETE |UPDATE |CREATE TABLE |CREATE INDEX)",
            "beginCaptures": {
                "2": {
                    "name": "keyword.sql"
                }
            },
            "end": "(')",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON key: value (same line), -- sql marker",
            "begin": "(?<=(?::)\\s*)(--\\s*sql)",
            "beginCaptures": {
                "1": {
                    "name": "comment.sql"
                }
            },
            "end": "$",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON key: value (same line), SQL keyword",
            "begin": "(?<=(?::)\\s*)(?i)(SELECT |INSERT INTO |DELETE |UPDATE |CREATE TABLE |CREATE INDEX)",
            "beginCaptures": {
                "1": {
                    "name": "keyword.sql"
                }
            },
            "end": "$",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON array element on its own line, -- sql marker",
            "begin": "^(\\s*)(--\\s*sql)",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.whitespace.leading.hjson"
                },
                "2": {
                    "name": "comment.sql"
                }
            },
            "end": "$",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        {
            "comment": "HJSON array element on its own line, SQL keyword",
            "begin": "^(\\s*)(?i)(SELECT |INSERT INTO |DELETE |UPDATE |CREATE TABLE |CREATE INDEX)",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.whitespace.leading.hjson"
                },
                "2": {
                    "name": "keyword.sql"
                }
            },
            "end": "$",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        }
    ]
}