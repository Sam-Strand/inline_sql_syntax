{
    "scopeName": "mkon-multiline.injection",
    "fileTypes": [
        "mkon"
    ],
    "injectionSelector": [
        "L:source.mkon -comment -string"
    ],
    "patterns": [
        {
            "comment": "MKON \"...\" single-line, -- sql marker",
            "begin": "(\")(--\\s*sql)",
            "beginCaptures": { "2": { "name": "comment.sql" } },
            "end": "(\")",
            "patterns": [ { "include": "source.sql" } ]
        },
        {
            "comment": "MKON \"...\" single-line, SQL keyword",
            "begin": "(?i)(\")(SELECT |INSERT INTO |DELETE |UPDATE |CREATE TABLE |CREATE INDEX)",
            "beginCaptures": { "2": { "name": "keyword.sql" } },
            "end": "(\")",
            "patterns": [ { "include": "source.sql" } ]
        },
        {
            "comment": "MKON '...' single-line, -- sql marker",
            "begin": "(')(--\\s*sql)",
            "beginCaptures": { "2": { "name": "comment.sql" } },
            "end": "(')",
            "patterns": [ { "include": "source.sql" } ]
        },
        {
            "comment": "MKON '...' single-line, SQL keyword",
            "begin": "(?i)(')(SELECT |INSERT INTO |DELETE |UPDATE |CREATE TABLE |CREATE INDEX)",
            "beginCaptures": { "2": { "name": "keyword.sql" } },
            "end": "(')",
            "patterns": [ { "include": "source.sql" } ]
        },
        {
            "comment": "MKON key: value (same line), -- sql marker",
            "begin": "(?<=(?::)\\s*)(--\\s*sql)",
            "beginCaptures": { "1": { "name": "comment.sql" } },
            "end": "$",
            "patterns": [ { "include": "source.sql" } ]
        },
        {
            "comment": "MKON key: value (same line), SQL keyword",
            "begin": "(?<=(?::)\\s*)(?i)(SELECT |INSERT INTO |DELETE |UPDATE |CREATE TABLE |CREATE INDEX)",
            "beginCaptures": { "1": { "name": "keyword.sql" } },
            "end": "$",
            "patterns": [ { "include": "source.sql" } ]
        },
        {
            "comment": "MKON array element on its own line, -- sql marker",
            "begin": "^(\\s*)(--\\s*sql)",
            "beginCaptures": {
                "1": { "name": "punctuation.whitespace.leading.mkon" },
                "2": { "name": "comment.sql" }
            },
            "end": "$",
            "patterns": [ { "include": "source.sql" } ]
        },
        {
            "comment": "MKON array element on its own line, SQL keyword",
            "begin": "^(\\s*)(?i)(SELECT |INSERT |DELETE |UPDATE |CREATE |DROP )",
            "beginCaptures": {
                "1": { "name": "punctuation.whitespace.leading.mkon" },
                "2": { "name": "keyword.sql" }
            },
            "end": "$",
            "patterns": [ { "include": "source.sql" } ]
        }
    ]
}
