{
    "name": "inline-sql-syntax",
    "displayName": "Inline SQL",
    "description": "Highlight and lint SQL strings and SQL files. Python, Go, Rust, JS, TS, Ruby, Java, C#, PHP, Lua, HJSON.",
    "version": "0.0.1",
    "author": "qufiwefefwoyn <qufiwefefwoyn@gmail.com>",
    "publisher": "Sam-Strand",
    "license": "MIT",
    "icon": "assets/logo.png",
    "repository": {
        "url": "https://github.com/Sam-Strand/inline_sql_syntax"
    },
    "homepage": "https://github.com/Sam-Strand/inline_sql_syntax",
    "engines": {
        "vscode": "^1.63.0"
    },
    "categories": [
        "Linters",
        "Other"
    ],
    "keywords": [
        "sql",
        "postgres",
        "mysql",
        "lint",
        "inline"
    ],
    "activationEvents": [
        "onLanguage:python",
        "onLanguage:go",
        "onLanguage:javascript",
        "onLanguage:typescript",
        "onLanguage:java",
        "onLanguage:ruby",
        "onLanguage:csharp",
        "onLanguage:rust",
        "onLanguage:sql",
        "onLanguage:php",
        "onLanguage:lua",
		"onLanguage:hjson"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "vite build",
        "watch": "vite build --watch",
        "package": "vite build"
    },
    "contributes": {
        "grammars": [
            {
                "path": "./syntaxes/highlight-sql-string.json",
                "scopeName": "inline-sql.injection",
                "injectTo": [
                    "source.python",
                    "source.java",
                    "source.ruby",
                    "source.cs",
                    "source.js",
                    "source.ts",
                    "source.vue",
                    "source.svelte",
                    "source.tsx",
                    "source.rust",
                    "text.html.php"
                ],
                "embeddedLanguages": {
                    "meta.embedded.sql": "sql"
                }
            },
            {
                "path": "./syntaxes/php-multiline.json",
                "scopeName": "php-multiline.injection",
                "injectTo": [
                    "text.html.php"
                ],
                "embeddedLanguages": {
                    "meta.embedded.sql": "sql"
                }
            },
            {
                "path": "./syntaxes/c-sharp-multiline.json",
                "scopeName": "c-sharp-multiline.injection",
                "injectTo": [
                    "source.cs"
                ],
                "embeddedLanguages": {
                    "meta.embedded.sql": "sql"
                }
            },
            {
                "path": "./syntaxes/lua-multiline.json",
                "scopeName": "lua-multiline.injection",
                "injectTo": [
                    "source.lua"
                ],
                "embeddedLanguages": {
                    "meta.embedded.sql": "sql"
                }
            },
            {
                "path": "./syntaxes/es6_inline.json",
                "scopeName": "es6_inline",
                "injectTo": [
                    "source.js",
                    "source.js.jsx",
                    "source.jsx",
                    "source.ts",
                    "source.tsx"
                ],
                "embeddedLanguages": {
                    "meta.embedded.sql": "sql",
                    "meta.template.expression.ts": "typescript"
                }
            },
            {
                "path": "./syntaxes/golang-multiline.json",
                "scopeName": "golang-multiline.injection",
                "injectTo": [
                    "source.go"
                ],
                "embeddedLanguages": {
                    "meta.embedded.sql": "sql"
                }
            },
            {
                "path": "./syntaxes/hjson-multiline.json",
                "scopeName": "hjson-multiline.injection",
                "injectTo": [
                    "source.hjson"
                ],
                "embeddedLanguages": {
                    "meta.embedded.sql": "sql"
                }
            }
        ],
        "configuration": {
            "title": "inline-sql-syntax",
            "properties": {
                "inlineSQL.enableDBIntegration": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Enable linting using real database."
                },
                "inlineSQL.dbDriver": {
                    "type": "string",
                    "default": "postgres",
                    "description": "Driver to use for verifying queries. It currently supports MySQL and Postgres.",
                    "enum": [
                        "mysql",
                        "postgres"
                    ]
                },
                "inlineSQL.dbHost": {
                    "type": "string",
                    "default": "localhost",
                    "markdownDescription": "Database host address."
                },
                "inlineSQL.dbPort": {
                    "type": "number",
                    "default": 5432,
                    "markdownDescription": "Database port."
                },
                "inlineSQL.dbUser": {
                    "type": "string",
                    "default": "postgres",
                    "markdownDescription": "Database user."
                },
                "inlineSQL.dbPassword": {
                    "type": "string",
                    "default": "postgres",
                    "markdownDescription": "Database password."
                },
                "inlineSQL.lintSQLFiles": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Enable linting for SQL files."
                }
            }
        }
    },
    "devDependencies": {
        "@types/node": "^17.0.21",
        "@types/vscode": "^1.63.0",
        "prettier": "2.6.2",
        "typescript": "^4.6.2",
        "vite": "^8.3.1"
    },
    "dependencies": {
        "sql-lint": "^0.0.19"
    }
}
